# Скопируйте этот файл в .env.local и при необходимости поменяйте значения.

# ── База данных ───────────────────────────────────────────────────────────────
# По умолчанию — встроенный локальный PostgreSQL (поднимается командой `npm run dev`).
# В продакшене сюда подставляется строка подключения Neon / Supabase / своего сервера.
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:54329/iskra

# Публичный адрес приложения (нужен для ссылок в OAuth и платежах)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Хранилище фотографий ──────────────────────────────────────────────────────
# local — папка ./uploads (разработка); blob — Vercel Blob (продакшен)
STORAGE_DRIVER=local
# BLOB_READ_WRITE_TOKEN=

# ── Необязательные интеграции (без ключей соответствующая функция просто скрыта) ──
# OAuth2 через Google
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Платежи: demo — встроенная тестовая касса; yookassa — ЮKassa
PAYMENT_PROVIDER=demo
# YOOKASSA_SHOP_ID=
# YOOKASSA_SECRET_KEY=

# Web Push (ключи генерируются командой `npm run push:keys`)
# NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:you@example.com

# Яндекс.Метрика
# NEXT_PUBLIC_YM_ID=
